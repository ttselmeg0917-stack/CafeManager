<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cafe.ProductController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Бүтээгдэхүүний бүртгэл" styleClass="title"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="nameField" promptText="Нэр" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="categoryBox" promptText="Төрөл" editable="true" prefWidth="150"/>
        <TextField fx:id="priceField" promptText="Үнэ (₮)" prefWidth="120"/>
    </HBox>
    <HBox spacing="10">
        <Button text="Нэмэх" onAction="#onAdd" styleClass="primary"/>
        <Button text="Засах" onAction="#onUpdate"/>
        <Button text="Устгах" onAction="#onDelete"/>
        <Button text="Цэвэрлэх" onAction="#onClear"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn text="ID" maxWidth="80"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
            <TableColumn text="Нэр"><cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory></TableColumn>
            <TableColumn text="Төрөл"><cellValueFactory><PropertyValueFactory property="category"/></cellValueFactory></TableColumn>
            <TableColumn text="Үнэ"><cellValueFactory><PropertyValueFactory property="priceText"/></cellValueFactory></TableColumn>
        </columns>
    </TableView>
</VBox>
