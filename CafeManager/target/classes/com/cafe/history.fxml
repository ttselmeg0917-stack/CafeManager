<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cafe.HistoryController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox spacing="16">
        <VBox styleClass="card, orange" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Өнөөдрийн захиалга" styleClass="card-title"/>
            <Label fx:id="countLabel" text="0" styleClass="card-value"/>
        </VBox>
        <VBox styleClass="card, green" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Өдрийн орлого" styleClass="card-title"/>
            <Label fx:id="revenueLabel" text="0₮" styleClass="card-value"/>
        </VBox>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Захиалгын түүх" styleClass="title"/>
        <Button text="Шинэчлэх" onAction="#refresh"/>
        <Button text="Баримт харах" onAction="#onReceipt"/>
    </HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView fx:id="orderTable" HBox.hgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <placeholder><Label text="Захиалга алга"/></placeholder>
            <columns>
                <TableColumn text="Дугаар" maxWidth="90"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
                <TableColumn text="Огноо"><cellValueFactory><PropertyValueFactory property="dateText"/></cellValueFactory></TableColumn>
                <TableColumn text="Хэлбэр"><cellValueFactory><PropertyValueFactory property="paymentMethod"/></cellValueFactory></TableColumn>
                <TableColumn text="Ажилтан"><cellValueFactory><PropertyValueFactory property="cashier"/></cellValueFactory></TableColumn>
                <TableColumn text="Төлбөр"><cellValueFactory><PropertyValueFactory property="totalText"/></cellValueFactory></TableColumn>
            </columns>
        </TableView>
        <TableView fx:id="itemTable" HBox.hgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <placeholder><Label text="Захиалга сонгож дэлгэрэнгүйг харна"/></placeholder>
            <columns>
                <TableColumn text="Бүтээгдэхүүн"><cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory></TableColumn>
                <TableColumn text="Тоо"><cellValueFactory><PropertyValueFactory property="quantity"/></cellValueFactory></TableColumn>
                <TableColumn text="Дүн"><cellValueFactory><PropertyValueFactory property="subtotalText"/></cellValueFactory></TableColumn>
            </columns>
        </TableView>
    </HBox>
</VBox>
